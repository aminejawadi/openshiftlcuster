<#
  Creates the OKD single-node VM in VirtualBox and adds the cluster names to
  the Windows hosts file. Generated by Ansible for {{ cluster_domain }}.

  Run in PowerShell as Administrator:
    .\create-okd-vm.ps1                 # download ISO, create and start the VM
    .\create-okd-vm.ps1 -UpdateHosts    # only rewrite the hosts file entries
    .\create-okd-vm.ps1 -Destroy        # stop and delete the VM, remove hosts entries
#>
#Requires -RunAsAdministrator
[CmdletBinding()]
param(
    [switch]$Destroy,
    [switch]$UpdateHosts,
    [switch]$Headless,
    [string]$BaseFolder = (Join-Path $HOME 'VirtualBox VMs')
)

# ---- Values from inventory/group_vars/all.yml --------------------------------
$VmName     = '{{ vm_name }}'
$IsoUrl     = 'http://{{ helper_ip }}:{{ http_port }}/okd/agent.x86_64.iso'
$Cpus       = {{ sno_vcpus }}
$MemoryMB   = {{ sno_memory_mb }}
$DiskGB     = {{ sno_disk_gb }}
$MacAddress = '{{ sno_mac | replace(":", "") | upper }}'
$NodeIp     = '{{ sno_ip }}'
$HostOnlyIp = '{{ lab_subnet }}.1'    # your PC's address on the host-only network
$HostNames  = @(
{% for name in windows_host_names %}
    '{{ name }}'{{ ',' if not loop.last else '' }}
{% endfor %}
)
{% raw %}
# ------------------------------------------------------------------------------
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'   # makes Invoke-WebRequest much faster
$Marker    = "# okd-vm:$VmName"
$HostsFile = Join-Path $env:SystemRoot 'System32\drivers\etc\hosts'
$VmDir     = Join-Path $BaseFolder $VmName
$Vdi       = Join-Path $VmDir "$VmName.vdi"
$Iso       = Join-Path $VmDir 'agent.x86_64.iso'

function Get-VBoxManage {
    $dirs = @($env:VBOX_MSI_INSTALL_PATH, $env:VBOX_INSTALL_PATH, 'C:\Program Files\Oracle\VirtualBox') |
            Where-Object { $_ }
    foreach ($dir in $dirs) {
        $exe = Join-Path $dir 'VBoxManage.exe'
        if (Test-Path $exe) { return $exe }
    }
    throw 'VirtualBox was not found (VBoxManage.exe is missing).'
}

# Runs VBoxManage and returns its output. Windows PowerShell turns native stderr
# into errors when ErrorActionPreference is Stop, and VBoxManage writes progress
# to stderr, so relax it here and check the exit code instead.
function Invoke-VBox {
    param([Parameter(ValueFromRemainingArguments = $true)][string[]]$Arguments)
    $previous = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'
    try {
        $output = & $script:VBoxManage @Arguments 2>&1 | ForEach-Object { "$_" }
        $code = $LASTEXITCODE
    } finally {
        $ErrorActionPreference = $previous
    }
    if ($code -ne 0) {
        throw "VBoxManage $($Arguments -join ' ') failed (exit $code):`n$($output -join "`n")"
    }
    return $output
}

function Test-VmExists {
    $names = Invoke-VBox list vms
    return [bool]($names | Where-Object { $_ -match "^`"$([regex]::Escape($VmName))`" " })
}

function Get-VmState {
    $info = Invoke-VBox showvminfo $VmName --machinereadable
    $line = $info | Where-Object { $_ -like 'VMState=*' } | Select-Object -First 1
    return ($line -replace '^VMState="?([^"]*)"?$', '$1')
}

function Get-HostOnlyAdapter {
    $name = $null
    foreach ($line in (Invoke-VBox list hostonlyifs)) {
        if ($line -match '^Name:\s+(.+)$') { $name = $Matches[1].Trim() }
        elseif ($line -match '^IPAddress:\s+(.+)$' -and $Matches[1].Trim() -eq $HostOnlyIp) { return $name }
    }
    throw ("No VirtualBox host-only adapter has the address $HostOnlyIp. 'vagrant up' creates it; " +
           "by hand, add one in VirtualBox: File > Tools > Network Manager > Host-only Networks.")
}

function Set-HostsEntries {
    param([bool]$Present)
    $lines = @(Get-Content -Path $HostsFile -ErrorAction SilentlyContinue |
               Where-Object { $_ -notlike "*$Marker" })
    if ($Present) {
        foreach ($name in $HostNames) { $lines += "$NodeIp`t$name`t$Marker" }
    }
    Set-Content -Path $HostsFile -Value $lines -Encoding ASCII
    Clear-DnsClientCache -ErrorAction SilentlyContinue
}

function Start-OkdVm {
    if ((Get-VmState) -ne 'running') {
        $type = if ($Headless) { 'headless' } else { 'gui' }
        Write-Host "Starting $VmName ($type) ..."
        Invoke-VBox startvm $VmName --type $type | Out-Null
    } else {
        Write-Host "$VmName is already running."
    }
}

$script:VBoxManage = Get-VBoxManage

if ($UpdateHosts) {
    Set-HostsEntries -Present $true
    Write-Host "Hosts file updated with $($HostNames.Count) names -> $NodeIp"
    return
}

if ($Destroy) {
    if (Test-VmExists) {
        Write-Host "Stopping and deleting $VmName ..."
        if ((Get-VmState) -in @('running', 'paused', 'stuck')) {
            Invoke-VBox controlvm $VmName poweroff | Out-Null
            Start-Sleep -Seconds 3
        }
        Invoke-VBox unregistervm $VmName --delete | Out-Null
    }
    if (Test-Path $VmDir) { Remove-Item -Path $VmDir -Recurse -Force }
    Set-HostsEntries -Present $false
    Write-Host "Removed $VmName and its hosts file entries."
    return
}

if (Test-VmExists) {
    # Already created (e.g. "vagrant up" run again): just make sure it is running.
    Write-Host "$VmName already exists. Use -Destroy to recreate it."
    Set-HostsEntries -Present $true
    Start-OkdVm
    return
}

$adapter = Get-HostOnlyAdapter
Write-Host "Using host-only adapter: $adapter"

New-Item -ItemType Directory -Path $VmDir -Force | Out-Null

Write-Host "Downloading the agent ISO from $IsoUrl (about 1 GB) ..."
Invoke-WebRequest -Uri $IsoUrl -OutFile $Iso -UseBasicParsing

Write-Host 'Creating the VM ...'
Invoke-VBox createvm --name $VmName --ostype RedHat_64 --basefolder $BaseFolder --register | Out-Null
Invoke-VBox modifyvm $VmName `
    --cpus $Cpus --memory $MemoryMB --vram 16 --graphicscontroller vmsvga `
    --ioapic on --rtcuseutc on --paravirtprovider kvm --firmware bios `
    --boot1 disk --boot2 dvd --boot3 none --boot4 none `
    --nic1 hostonly --hostonlyadapter1 $adapter --nictype1 virtio --macaddress1 $MacAddress | Out-Null

Write-Host "Creating a $DiskGB GB dynamically allocated disk ..."
Invoke-VBox createmedium disk --filename $Vdi --size ($DiskGB * 1024) --format VDI | Out-Null
Invoke-VBox storagectl $VmName --name SATA --add sata --controller IntelAhci --portcount 2 --hostiocache on | Out-Null
Invoke-VBox storageattach $VmName --storagectl SATA --port 0 --device 0 --type hdd `
    --medium $Vdi --nonrotational on --discard on | Out-Null
Invoke-VBox storageattach $VmName --storagectl SATA --port 1 --device 0 --type dvddrive `
    --medium $Iso | Out-Null

Write-Host 'Adding cluster names to the Windows hosts file ...'
Set-HostsEntries -Present $true

Start-OkdVm

Write-Host ''
Write-Host 'Done. The VM boots from the ISO (the disk is empty), installs to disk and'
Write-Host 'reboots from the disk by itself.'
Write-Host 'Back on the helper, run: ansible-playbook playbooks/03-wait-for-install.yml'
{% endraw %}
