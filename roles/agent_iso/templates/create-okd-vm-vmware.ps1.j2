<#
  Creates the OKD single-node VM in VMware Workstation and adds the cluster
  names to the Windows hosts file. Generated by Ansible for {{ cluster_domain }}.

  Run in PowerShell as Administrator:
    .\create-okd-vm.ps1                 # download ISO, create and start the VM
    .\create-okd-vm.ps1 -UpdateHosts    # only rewrite the hosts file entries
    .\create-okd-vm.ps1 -Destroy        # stop and delete the VM, remove hosts entries
#>
#Requires -RunAsAdministrator
[CmdletBinding()]
param(
    [switch]$Destroy,
    [switch]$UpdateHosts,
    [string]$VmDir = (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'Virtual Machines\{{ vm_name }}')
)

# ---- Values from inventory/group_vars/all.yml --------------------------------
$VmName     = '{{ vm_name }}'
$IsoUrl     = 'http://{{ helper_ip }}:{{ http_port }}/okd/agent.x86_64.iso'
$Cpus       = {{ sno_vcpus }}
$MemoryMB   = {{ sno_memory_mb }}
$DiskGB     = {{ sno_disk_gb }}
$MacAddress = '{{ sno_mac | upper }}'
$NodeIp     = '{{ sno_ip }}'
$HostNames  = @(
{% for name in windows_host_names %}
    '{{ name }}'{{ ',' if not loop.last else '' }}
{% endfor %}
)
{% raw %}
# ------------------------------------------------------------------------------
$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'   # makes Invoke-WebRequest much faster
$Marker    = "# okd-vm:$VmName"
$HostsFile = Join-Path $env:SystemRoot 'System32\drivers\etc\hosts'
$Vmx       = Join-Path $VmDir "$VmName.vmx"
$Vmdk      = Join-Path $VmDir "$VmName.vmdk"
$Iso       = Join-Path $VmDir 'agent.x86_64.iso'

function Get-WorkstationPath {
    $keys = @(
        'HKLM:\SOFTWARE\WOW6432Node\VMware, Inc.\VMware Workstation',
        'HKLM:\SOFTWARE\VMware, Inc.\VMware Workstation'
    )
    foreach ($key in $keys) {
        $item = Get-ItemProperty -Path $key -Name InstallPath -ErrorAction SilentlyContinue
        if ($item -and (Test-Path (Join-Path $item.InstallPath 'vmrun.exe'))) { return $item.InstallPath }
    }
    $default = 'C:\Program Files (x86)\VMware\VMware Workstation'
    if (Test-Path (Join-Path $default 'vmrun.exe')) { return $default }
    throw 'VMware Workstation Pro was not found (vmrun.exe is missing).'
}

function Invoke-Tool {
    param([string]$Exe, [string[]]$Arguments, [switch]$AllowFailure)
    # Quote each argument so paths with spaces survive Start-Process.
    $quoted = $Arguments | ForEach-Object { if ($_ -match '\s') { '"' + $_ + '"' } else { $_ } }
    $proc = Start-Process -FilePath $Exe -ArgumentList $quoted -NoNewWindow -Wait -PassThru
    if ($proc.ExitCode -ne 0 -and -not $AllowFailure) {
        throw "$(Split-Path $Exe -Leaf) failed with exit code $($proc.ExitCode)"
    }
}

function Set-HostsEntries {
    param([bool]$Present)
    $lines = @(Get-Content -Path $HostsFile -ErrorAction SilentlyContinue |
               Where-Object { $_ -notlike "*$Marker" })
    if ($Present) {
        foreach ($name in $HostNames) { $lines += "$NodeIp`t$name`t$Marker" }
    }
    Set-Content -Path $HostsFile -Value $lines -Encoding ASCII
    Clear-DnsClientCache -ErrorAction SilentlyContinue
}

$Workstation = Get-WorkstationPath
$Vmrun       = Join-Path $Workstation 'vmrun.exe'
$DiskManager = Join-Path $Workstation 'vmware-vdiskmanager.exe'

if ($UpdateHosts) {
    Set-HostsEntries -Present $true
    Write-Host "Hosts file updated with $($HostNames.Count) names -> $NodeIp"
    return
}

if ($Destroy) {
    if (Test-Path $Vmx) {
        Write-Host "Stopping and deleting $VmName ..."
        Invoke-Tool $Vmrun @('-T', 'ws', 'stop', $Vmx, 'hard') -AllowFailure
        Invoke-Tool $Vmrun @('-T', 'ws', 'deleteVM', $Vmx) -AllowFailure
    }
    if (Test-Path $VmDir) { Remove-Item -Path $VmDir -Recurse -Force }
    Set-HostsEntries -Present $false
    Write-Host "Removed $VmName and its hosts file entries."
    return
}

if (Test-Path $Vmx) {
    # Already created (e.g. "vagrant up" run again): just make sure it is running.
    Write-Host "$VmName already exists; starting it if needed. Use -Destroy to recreate it."
    Set-HostsEntries -Present $true
    Invoke-Tool $Vmrun @('-T', 'ws', 'start', $Vmx, 'gui') -AllowFailure
    return
}

New-Item -ItemType Directory -Path $VmDir -Force | Out-Null

Write-Host "Downloading the agent ISO from $IsoUrl (about 1 GB) ..."
Invoke-WebRequest -Uri $IsoUrl -OutFile $Iso -UseBasicParsing

Write-Host "Creating a $DiskGB GB thin-provisioned disk ..."
Invoke-Tool $DiskManager @('-c', '-s', "$($DiskGB)GB", '-a', 'lsilogic', '-t', '0', $Vmdk)

Write-Host 'Writing the VM configuration ...'
$vmxText = @"
.encoding = "windows-1252"
config.version = "8"
virtualHW.version = "19"
displayName = "$VmName"
guestOS = "other5xlinux-64"
firmware = "efi"
numvcpus = "$Cpus"
cpuid.coresPerSocket = "$Cpus"
memsize = "$MemoryMB"
mem.hotadd = "FALSE"
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"
scsi0.present = "TRUE"
scsi0.virtualDev = "pvscsi"
scsi0:0.present = "TRUE"
scsi0:0.fileName = "$VmName.vmdk"
sata0.present = "TRUE"
sata0:1.present = "TRUE"
sata0:1.deviceType = "cdrom-image"
sata0:1.fileName = "agent.x86_64.iso"
sata0:1.startConnected = "TRUE"
ethernet0.present = "TRUE"
ethernet0.connectionType = "nat"
ethernet0.virtualDev = "vmxnet3"
ethernet0.addressType = "static"
ethernet0.address = "$MacAddress"
ethernet0.pciSlotNumber = "160"
bios.bootOrder = "hdd,cdrom"
disk.EnableUUID = "TRUE"
uuid.action = "create"
tools.syncTime = "TRUE"
"@
Set-Content -Path $Vmx -Value $vmxText -Encoding ASCII

Write-Host 'Adding cluster names to the Windows hosts file ...'
Set-HostsEntries -Present $true

Write-Host "Starting $VmName ..."
Invoke-Tool $Vmrun @('-T', 'ws', 'start', $Vmx, 'gui')

Write-Host ''
Write-Host "Done. The VM boots from the ISO, installs to disk and reboots by itself."
Write-Host "Back on the helper, run: ansible-playbook playbooks/03-wait-for-install.yml"
{% endraw %}
